# Papandu Environment Variables

# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-09-17

# Paystack Payment Gateway
# Replace with your Paystack Public and Secret keys
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=sk_test_demo_secret_key_here

# Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend Email Configuration
# API key from resend.com (e.g. re_xxxxxxx)
RESEND_API_KEY=
# Sender email with verified subdomain
RESEND_FROM_EMAIL="PAPANDU <orders@send.papandu.store>"

# Drop Launch Schedule (Lagos / West Africa Time, UTC+1)
# Controls automatic transition from 'COMING SOON' to live
NEXT_PUBLIC_DROP_LAUNCH_DATE="2026-09-23T00:00:00+01:00"
